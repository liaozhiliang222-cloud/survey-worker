PORT=4281
SURVEYKIT_RELEASE=dev
SURVEYKIT_COMMIT=local
SURVEYKIT_DEPLOYED_AT=
PPTX_BACKEND_URL=http://127.0.0.1:8000
PPTX_PROXY_TIMEOUT_MS=120000
PPTX_PROXY_MAX_BODY_BYTES=31457280
# 定性报告优先由 OfficeCLI 原生渲染，python-pptx 仅作为兼容回退。
# auto：OfficeCLI 可用时优先使用，否则回退；officecli：必须使用；python-pptx：显式使用兼容引擎。
QUALITATIVE_PPT_RENDER_ENGINE=auto
# prefer：OfficeCLI 不可用时允许回退；required：缺失、渲染或校验失败即阻断；off：兼容引擎不做追加门禁。
QUALITATIVE_PPT_OFFICECLI_QA=prefer
OFFICECLI_PATH=
OFFICECLI_TIMEOUT_SECONDS=180
OFFICECLI_NO_AUTO_RESIDENT=1
AI_PROXY_MAX_BODY_BYTES=1048576
# 火山方舟 Agent Plan（全站内置 AI 的首选路由）。API Key 仅放本地 .env.local 或云端 Secret。
VOLCENGINE_AGENT_PLAN_API_URL=https://ark.cn-beijing.volces.com/api/plan/v3/chat/completions
VOLCENGINE_AGENT_PLAN_MODELS=glm-5.3-flash
VOLCENGINE_AGENT_PLAN_API_KEY=
SURVEYKIT_GATEWAY_API_URL=http://api.surveykit.cc/v1/chat/completions
SURVEYKIT_GATEWAY_MODELS=deepseek-v4-flash
SURVEYKIT_GATEWAY_API_KEY=
SENSENOVA_API_URL=https://token.sensenova.cn/v1/chat/completions
SENSENOVA_MODELS=deepseek-v4-flash
SENSENOVA_API_KEY=
BAILIAN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_MODELS=deepseek-v4-pro,deepseek-v4-flash,qwen3.7-max,qwen3.7-plus,glm-5.2,kimi-k2.6,qwen3.6-plus,qwen3-max,deepseek-v3.2,glm-5.1,qwen3.5-plus
DASHSCOPE_API_KEY=
AI_PROXY_ALLOWED_HOSTS=

# AI 研究员默认直连火山方舟 Agent Plan；可改回 dsh-rpc / opencode 兼容模式。
HARNESS_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
HARNESS_API_KEY=
HARNESS_API_STYLE=openai-chat
HARNESS_USERNAME=
HARNESS_PASSWORD=
HARNESS_AGENT_PRESET=surveykit-research
HARNESS_MODEL_PROVIDER=volcengine-agent-plan
HARNESS_MODEL=glm-5.3-flash
HARNESS_REASONING_EFFORT=low
HARNESS_MAX_OUTPUT_TOKENS=16384
HARNESS_CWD=
HARNESS_CLIENT_TIME_ZONE=Asia/Shanghai
HARNESS_POLL_INTERVAL=1000
HARNESS_TIMEOUT=300000
HARNESS_LONG_TASK_TIMEOUT=300000
HARNESS_MAX_CONTINUATIONS=3
HARNESS_MAX_TOOL_CALLS=5
HARNESS_MAX_DATA_TOOL_CALLS=8
HARNESS_MAX_QUALITATIVE_TOOL_CALLS=10
# 单访谈深度摘要留空时继承同一火山方舟模型；需要独立路由时再显式覆盖。
HARNESS_TRANSCRIPT_SUMMARY_AGENT_PRESET=
HARNESS_TRANSCRIPT_SUMMARY_MODEL_PROVIDER=
HARNESS_TRANSCRIPT_SUMMARY_MODEL=
HARNESS_TRANSCRIPT_SUMMARY_REASONING_EFFORT=
HARNESS_TRANSCRIPT_SUMMARY_TIMEOUT=180000
HARNESS_TRANSCRIPT_SUMMARY_MAX_CONTINUATIONS=1
# 笔录校正按 Segment 小批次执行；建议使用稳定、低成本且结构化输出可靠的模型。
HARNESS_TRANSCRIPT_CORRECTION_AGENT_PRESET=
HARNESS_TRANSCRIPT_CORRECTION_MODEL_PROVIDER=
HARNESS_TRANSCRIPT_CORRECTION_MODEL=
HARNESS_TRANSCRIPT_CORRECTION_REASONING_EFFORT=
HARNESS_TRANSCRIPT_CORRECTION_TIMEOUT=120000
HARNESS_TRANSCRIPT_CORRECTION_MAX_CONTINUATIONS=0
TRANSCRIPT_CORRECTION_CONCURRENCY=2
RESEARCH_TRANSCRIPT_CORRECTION_MAX_FILES=10
RESEARCH_TRANSCRIPT_CORRECTION_BATCH_SEGMENTS=4
RESEARCH_TRANSCRIPT_CORRECTION_CONTEXT_SEGMENTS=1
RESEARCH_DATA_ASYNC_CELL_THRESHOLD=2000000
SURVEYKIT_TOOL_API_KEY=
SURVEYKIT_AGENT_TOOL_URL=https://surveykit.cc/api/tools/agent

# 本地 Node 开发专用。
RESEARCH_DEV_USER_ID=local-developer
RESEARCH_DATA_FILE=.data/research.json
RESEARCH_FILES_DIR=.data/research-files

# 项目文件、上下文和匿名 AI 用量保护
RESEARCH_MAX_FILE_BYTES=26214400
RESEARCH_MAX_FILES_PER_PROJECT=30
RESEARCH_MAX_PARSED_CHARS=250000
RESEARCH_FILE_SUMMARY_CHARS=2000
RESEARCH_MAX_CONTEXT_CHARS=30000
RESEARCH_MAX_PROJECT_CONTEXT_CHARS=6000
RESEARCH_MAX_ARTIFACT_CHARS=12000
RESEARCH_MAX_FILE_SUMMARY_CHARS=2000
RESEARCH_MAX_FILE_EXCERPT_CHARS=3000
RESEARCH_MAX_SELECTED_FILES=8
RESEARCH_MEMORY_CHUNK_CHARS=1800
RESEARCH_MEMORY_CHUNK_OVERLAP=180
RESEARCH_MAX_CHUNKS_PER_FILE=48
RESEARCH_MAX_RETRIEVED_CHUNKS=5
RESEARCH_MAX_RETRIEVED_CHUNK_CHARS=1600
RESEARCH_MAX_RECENT_MESSAGES=6
RESEARCH_MAX_RECENT_MESSAGE_CHARS=1200
# 定性小结使用更大的笔录上下文；其他任务继续沿用上方常规预算。
RESEARCH_QUALITATIVE_MAX_CONTEXT_CHARS=80000
RESEARCH_QUALITATIVE_MAX_ARTIFACT_CHARS=30000
RESEARCH_QUALITATIVE_MAX_FILE_SUMMARY_CHARS=4000
RESEARCH_QUALITATIVE_MAX_FILE_EXCERPT_CHARS=20000
RESEARCH_QUALITATIVE_MAX_SELECTED_FILES=20
RESEARCH_QUALITATIVE_MAX_RETRIEVED_CHUNKS=8
RESEARCH_QUALITATIVE_MAX_RETRIEVED_CHUNK_CHARS=3000
RESEARCH_QUALITATIVE_MAX_RECENT_MESSAGES=4
# Excel 逐访谈小结送入 Harness 的全部笔录字符预算（模板问题框架另计）。
RESEARCH_QUALITATIVE_EXCEL_MAX_TRANSCRIPT_CHARS=90000
# 深度摘要缓存：均匀抽取的最大原文预算、目标长度和缓存上限。
RESEARCH_TRANSCRIPT_SUMMARY_MAX_SOURCE_CHARS=120000
RESEARCH_TRANSCRIPT_SUMMARY_TARGET_CHARS=4000
RESEARCH_TRANSCRIPT_SUMMARY_MAX_CHARS=20000
# Report Storyline 只注入当前项目的压缩 Evidence Index；不会重读原始数据或逐字稿。
RESEARCH_REPORT_MAX_EVIDENCE=160
RESEARCH_REPORT_EVIDENCE_CONTEXT_CHARS=48000
RESEARCH_REPORT_MAX_CONTEXT_CHARS=60000
# PPT Script 只注入 Report Outline、Core Insights 与关联 Evidence，不注入原始逐字稿或数据行。
RESEARCH_PPT_SCRIPT_MAX_EVIDENCE=200
RESEARCH_PPT_SCRIPT_EVIDENCE_CONTEXT_CHARS=48000
RESEARCH_PPT_SCRIPT_MAX_CONTEXT_CHARS=70000
RESEARCH_AI_REQUESTS_PER_MINUTE=12
RESEARCH_AI_REQUESTS_PER_DAY=500

# 可选外部 OCR。服务接收 PDF 原始字节，返回 JSON：{"text":"...","provider":"..."}。
RESEARCH_OCR_ENDPOINT=
RESEARCH_OCR_API_KEY=
RESEARCH_OCR_TIMEOUT=120000

# Cloudflare Pages 生产环境：默认匿名共享工作区，并绑定 D1 为 RESEARCH_DB、R2 为 RESEARCH_FILES。
# 匿名模式下，同一部署的所有访问者共享项目。RESEARCH_ANONYMOUS_USER_ID 仅由服务端配置。
RESEARCH_AUTH_MODE=anonymous
RESEARCH_ANONYMOUS_USER_ID=shared-workspace

# 如需登录与用户隔离，将 RESEARCH_AUTH_MODE 改为 access，再配置以下两项。
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=
